{
    "name": "@containers/engine-agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun build src/server.ts --outdir dist --target bun",
        "dev": "bun --watch src/server.ts",
        "start": "bun dist/server.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@containers/config": "workspace:*",
        "@containers/contracts": "workspace:*",
        "hono": "4.12.33",
        "zod": "4.4.3"
    }
}
