{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "incremental": true,
        "jsx": "preserve",
        "lib": ["dom", "dom.iterable", "esnext"],
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@app/*": ["./src/app/*"],
            "@entities/*": ["./src/entities/*"],
            "@features/*": ["./src/features/*"],
            "@shared/*": ["./src/shared/*"],
            "@widgets/*": ["./src/widgets/*"]
        }
    },
    "include": ["next-env.d.ts", ".next/types/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules"]
}
