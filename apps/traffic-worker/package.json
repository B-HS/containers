{
    "name": "@containers/traffic-worker",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun build src/server.ts --outdir dist --target bun && bun build src/db/query-worker-entry.ts --outfile dist/query-worker-entry.ts --target bun",
        "dev": "bun --watch src/server.ts",
        "start": "bun dist/server.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@containers/config": "workspace:*",
        "@containers/contracts": "workspace:*",
        "drizzle-orm": "0.45.2",
        "hono": "4.12.33",
        "hono-openapi": "1.3.1",
        "zod": "4.4.3"
    }
}
