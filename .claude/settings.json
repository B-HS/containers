{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-container-escape.sh",
                        "timeout": 20
                    }
                ]
            }
        ]
    },
    "permissions": {
        "deny": [
            "Bash(docker run --privileged*)",
            "Bash(docker run --pid=host*)",
            "Bash(docker run --network=host*)",
            "Bash(docker run --net=host*)",
            "Bash(nsenter*)",
            "Bash(sudo *)"
        ]
    }
}
